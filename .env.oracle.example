# Copy this file to .env on the VM and replace every example value.
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# Used to encrypt API keys registered from the administrator UI.
SECRET_ENCRYPTION_KEY=replace-with-another-openssl-rand-hex-32
CORS_ORIGINS=https://sports.example.com

# Store the SQLite DB and daily backups in /home/ubuntu/sports-expect/data.
# This makes off-VM backup downloads straightforward.
DATA_VOLUME=./data

# With a domain, Caddy obtains and renews HTTPS automatically.
SPORTS_EXPECT_SITE_ADDRESS=sports.example.com

# Shared read-only site login for the four intended viewers.
ACCESS_USER=viewer
# Put the Caddy bcrypt hash inside single quotes. Single quotes keep the dollar
# signs literal when Docker Compose reads this file.
ACCESS_PASSWORD_HASH='replace-with-caddy-hash'

# Optional: API-Sports Baseball market totals/spreads for comparison only.
API_SPORTS_KEY=
API_SPORTS_MLB_LEAGUE_ID=1
API_SPORTS_KBO_LEAGUE_ID=3
API_SPORTS_DAILY_REQUEST_BUDGET=20

# Optional Claude prediction advisor. Register the key, choose the model and enable it
# from the administrator UI after deployment. Execution limits are fixed in application code.

# Operational defaults. Change only after measuring the server.
MONTE_CARLO_SIMS=20000
BACKUP_RETENTION_DAYS=14
STALE_AFTER_MINUTES=360

# For a temporary IP-only HTTP test, use this instead and do not send admin tokens:
# SPORTS_EXPECT_SITE_ADDRESS=http://203.0.113.10
