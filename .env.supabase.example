# Supabase Dashboard > Connect > Transaction pooler URI (port 6543)
BASEBALL_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Generate a long random value. Never commit the real value.
ADMIN_TOKEN=replace-with-a-long-random-token
# Required. Keeps user-owned Claude keys independent from the Cron token.
SECRET_ENCRYPTION_KEY=replace-with-another-long-random-secret

# Supabase Auth project values. The publishable key is safe to use for JWT validation.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Frontend production origin only. Add comma-separated origins if needed.
CORS_ORIGINS=https://your-dugout-web.vercel.app

# Claude keys and models are managed separately by each signed-in user.
API_SPORTS_KEY=
API_SPORTS_DAILY_REQUEST_BUDGET=20
MONTE_CARLO_SIMS=20000
AUTO_CREATE_SCHEMA=false
