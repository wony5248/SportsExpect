# Supabase Dashboard > Connect > Transaction pooler URI (port 6543)
BASEBALL_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Generate a long random value. Never commit the real value.
ADMIN_TOKEN=replace-with-a-long-random-token

# Frontend production origin only. Add comma-separated origins if needed.
CORS_ORIGINS=https://your-dugout-web.vercel.app

ANTHROPIC_API_KEY=
CLAUDE_PREDICTION_ENABLED=false
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_BLEND_WEIGHT=0.15
ODDS_API_KEY=
MONTE_CARLO_SIMS=20000
AUTO_CREATE_SCHEMA=false
