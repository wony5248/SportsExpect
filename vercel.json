{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://sports-expect-six.vercel.app" },
        { "key": "Vary", "value": "Origin" }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 3009,
      "excludeFiles": "{frontend/**,backend/tests/**,docs/**,data/**,scripts/**,**/__pycache__/**}"
    }
  }
}
